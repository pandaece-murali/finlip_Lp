# Finlip Security - Lead Email & Google Sheet Configuration

# 1. GMAIL SMTP (App Password)
# Enter your Gmail address (e.g. finlipsecurity@gmail.com)
GMAIL_USER=finlipsecurity@gmail.com

# 16-character Google App Password (Generate at: https://myaccount.google.com/apppasswords)
# Note: Do not use your regular Gmail password. Generate an App Password.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the lead emails should be delivered (defaults to GMAIL_USER if left blank)
LEAD_RECEIVER_EMAIL=finlipsecurity@gmail.com

# 2. GOOGLE SHEET WEBHOOK (Optional/Recommended)
# Paste your Google Apps Script Webhook URL below
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
